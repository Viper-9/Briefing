<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unity.VectorGraphics 를 참조하는 코드는 여기에만 둔다. 바닐라 EFT 에 없는 DLL 이라 Briefing.Client 가 참조하면
       다른 모드의 GetTypes 가 깨진다. 배포 때 lib/Briefing.Svg.bin 으로 이름을 바꿔 두고 SvgLoader 가 직접 올린다. -->
  <PropertyGroup>
    <AssemblyName>Briefing.Svg</AssemblyName>
    <RootNamespace>Briefing.Svg</RootNamespace>
    <TargetFramework>netstandard2.1</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Managed>$(SptRoot)\EscapeFromTarkov_Data\Managed</Managed>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Managed)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(Managed)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(Managed)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(SptRoot)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <!-- DynamicMaps 배포본과 같은 바이트. 빌드용 참조이고, 배포 zip 에는 lib/*.bin 으로 들어간다 -->
    <Reference Include="Unity.VectorGraphics"><HintPath>..\lib\Unity.VectorGraphics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.InternalAPIEngineBridge.003"><HintPath>..\lib\Unity.InternalAPIEngineBridge.003.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Briefing.Client\Briefing.Client.csproj" Private="false" />
  </ItemGroup>
  <Target Name="RequireSptRoot" BeforeTargets="ResolveAssemblyReferences;CoreCompile">
    <Error Condition="'$(SptRoot)' == ''" Text="SptRoot is not set. Create Briefing.local.props from Briefing.local.props.example and set SptRoot." />
  </Target>
</Project>
